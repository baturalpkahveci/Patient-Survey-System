@model SubmitSurveyViewModel

@{
    ViewData["Title"] = Model.Title;
}

<section class="survey-page">
    <header class="survey-header">
        <h1>@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }
    </header>

    <form asp-action="Submit" method="post" class="survey-form">
        @Html.AntiForgeryToken()
        <input asp-for="Token" type="hidden" />
        <input asp-for="InvitationId" type="hidden" />
        <input asp-for="SurveyId" type="hidden" />

        @if (!string.IsNullOrWhiteSpace(Model.FormError))
        {
            <div class="validation-summary">@Model.FormError</div>
        }

        @if (Model.Departments.Count > 0)
        {
            <div class="field-block">
                <label asp-for="DepartmentId">Bölüm</label>
                <select asp-for="DepartmentId">
                    <option value="">Bölüm seçin</option>
                    @foreach (var department in Model.Departments)
                    {
                        <option value="@department.Id">@department.Name</option>
                    }
                </select>
                <span asp-validation-for="DepartmentId" class="field-validation"></span>
            </div>
        }

        <ol class="question-list">
            @for (var i = 0; i < Model.Questions.Count; i++)
            {
                <li class="question-item">
                    <input asp-for="Questions[i].Id" type="hidden" />
                    <div class="question-title">
                        <span>@Model.Questions[i].Text</span>
                        @if (Model.Questions[i].IsRequired)
                        {
                            <strong>Zorunlu</strong>
                        }
                    </div>

                    @if (Model.Questions[i].Type == QuestionType.Score)
                    {
                        <div class="score-options">
                            @for (var score = 1; score <= 5; score++)
                            {
                                <label>
                                    <input type="radio" name="Questions[@i].ScoreValue" value="@score" checked="@(Model.Questions[i].ScoreValue == score)" />
                                    <span>@score</span>
                                </label>
                            }
                        </div>
                    }
                    else if (Model.Questions[i].Type == QuestionType.Text)
                    {
                        <textarea name="Questions[@i].TextValue" rows="4">@Model.Questions[i].TextValue</textarea>
                    }
                    else if (Model.Questions[i].Type == QuestionType.Boolean)
                    {
                        <select name="Questions[@i].BooleanValue">
                            <option value="">Seçin</option>
                            <option value="true" selected="@(Model.Questions[i].BooleanValue == true)">Evet</option>
                            <option value="false" selected="@(Model.Questions[i].BooleanValue == false)">Hayır</option>
                        </select>
                    }
                </li>
            }
        </ol>

        @if (Model.InvitationId.HasValue)
        {
            <section class="survey-consent-section">
                <h2>Kimlik ve KVKK Onayı</h2>

                <div class="field-block">
                    <label asp-for="TcIdentityNumber">T.C. Kimlik Numarası</label>
                    <input asp-for="TcIdentityNumber" inputmode="numeric" autocomplete="off" />
                    <span asp-validation-for="TcIdentityNumber" class="field-validation"></span>
                </div>

                <section class="kvkk-notice">
                    <button type="button" class="link-button" data-kvkk-toggle>Aydınlatma Metni</button>
                    <p data-kvkk-text hidden>@Model.ConsentNoticeText</p>
                    @if (!string.IsNullOrWhiteSpace(Model.ConsentNoticeVersion))
                    {
                        <small>Versiyon @Model.ConsentNoticeVersion</small>
                    }
                </section>

                <label class="check-row">
                    <input asp-for="KvkkAccepted" />
                    <span>KVKK Aydınlatma Metni'ni okudum ve onay durumumu bildiriyorum.</span>
                </label>
                <span asp-validation-for="KvkkAccepted" class="field-validation"></span>
            </section>
        }

        <button type="submit" class="primary-button">Gönder</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
