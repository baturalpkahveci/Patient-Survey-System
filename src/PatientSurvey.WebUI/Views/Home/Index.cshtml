@{
    ViewData["Title"] = "Ana Sayfa";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isManager = User.IsInRole("Manager");
}

<section class="home-dashboard">
    <div class="home-intro">
        <span class="eyebrow">Hasta deneyimi takibi</span>
        <h1>Hasta Memnuniyet Anketi</h1>
        <p>Anketler tek kullanımlık bağlantılarla paylaşılır; cevaplar bölüm bazında raporlanır ve yönetim panelinden takip edilir.</p>
        <div class="home-actions">
            @if (isAuthenticated)
            {
                <a class="primary-button" asp-area="@(isManager ? "Manager" : "Admin")" asp-controller="Dashboard" asp-action="Index">Panele Git</a>
            }
            else
            {
                <a class="primary-button" asp-controller="Account" asp-action="Login">Yönetim Girişi</a>
            }
        </div>
    </div>

    <div class="workflow-strip" aria-label="Uygulama akış adımları">
        <div>
            <span>1</span>
            <strong>Anketi hazırla</strong>
            <p>Bölümleri, soruları ve aktif anketleri düzenle.</p>
        </div>
        <div>
            <span>2</span>
            <strong>Link üret</strong>
            <p>Hasta için tek kullanımlık ve takip edilebilir bağlantı oluştur.</p>
        </div>
        <div>
            <span>3</span>
            <strong>Sonuçları izle</strong>
            <p>Cevapları, ortalama puanları ve bölüm performansını raporla.</p>
        </div>
    </div>
</section>
