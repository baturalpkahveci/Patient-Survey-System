@model LoginViewModel

@{
    ViewData["Title"] = "Giriş";
}

<section class="auth-page">
    <div class="auth-copy">
        <span class="eyebrow">Yetkili erişimi</span>
        <h1>Yönetim paneline giriş yap</h1>
        <p>Admin kullanıcıları tüm yapilandirmayi yönetir. Manager kullanıcıları link, sonuc ve rapor ekranlarina erisir.</p>
    </div>

    <div class="auth-panel">
        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="field-block">
                <label asp-for="Username">Kullanıcı adı</label>
                <input asp-for="Username" autocomplete="username" />
                <span asp-validation-for="Username" class="field-validation"></span>
            </div>

            <div class="field-block">
                <label asp-for="Password">Şifre</label>
                <input asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>

            <button type="submit" class="primary-button full-width">Giriş Yap</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
