@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<section class="message-panel">
    <h1>İşlem sırasında beklenmeyen bir hata oluştu.</h1>
    <p>Lütfen daha sonra tekrar deneyin.</p>

    @if (Model.ShowRequestId)
    {
        <p class="muted">İstek kodu: <code>@Model.RequestId</code></p>
    }
</section>
