@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? string.Empty;
    var isAdminArea = currentArea == "Admin";
    var isManagerArea = currentArea == "Manager";
    var isDoctorArea = currentArea == "Doctor";
    var doctorDisplayName = User.FindFirst("doctor_display_name")?.Value;
    var doctorDepartmentName = User.FindFirst("doctor_department_name")?.Value;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hasta Memnuniyet Anketi</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/survey.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="topbar">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">PS</span>
                <span>
                    <strong>Hasta Memnuniyet Anketi</strong>
                    <small>Yönetim ve raporlama sistemi</small>
                </span>
            </a>
            <div class="nav-links">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Manager"))
                    {
                        <a class="@(isManagerArea ? "is-active" : null)" asp-area="Manager" asp-controller="Dashboard" asp-action="Index">Manager Paneli</a>
                    }
                    else if (User.IsInRole("Doctor"))
                    {
                        <a class="@(isDoctorArea ? "is-active" : null)" asp-area="Doctor" asp-controller="Dashboard" asp-action="Index">Doktor Paneli</a>
                        <span class="doctor-top-profile">
                            <strong>@(doctorDisplayName ?? User.Identity?.Name ?? "Doktor")</strong>
                            @if (!string.IsNullOrWhiteSpace(doctorDepartmentName))
                            {
                                <small>@doctorDepartmentName</small>
                            }
                        </span>
                    }
                    else
                    {
                        <a class="@(isAdminArea ? "is-active" : null)" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin Paneli</a>
                    }
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="link-button">Çıkış</button>
                    </form>
                }
                else
                {
                    <a asp-area="" asp-controller="Account" asp-action="Login">Giriş</a>
                }
            </div>
        </nav>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="subnav">
                @if (User.IsInRole("Manager"))
                {
                    <a class="@(isManagerArea ? "is-active" : null)" asp-area="Manager" asp-controller="Dashboard" asp-action="Index">Özet</a>
                    <a asp-area="Manager" asp-controller="Tokens" asp-action="Index">Anket Linkleri</a>
                    <a asp-area="Manager" asp-controller="PatientVisits" asp-action="Index">Hasta Ziyaretleri</a>
                    <a asp-area="Manager" asp-controller="Results" asp-action="Index">Sonuçlar</a>
                    <a asp-area="Manager" asp-controller="Reports" asp-action="Index">Raporlar</a>
                }
                else if (User.IsInRole("Doctor"))
                {
                    <a class="@(isDoctorArea ? "is-active" : null)" asp-area="Doctor" asp-controller="Dashboard" asp-action="Index">Özet</a>
                    <a asp-area="Doctor" asp-controller="Surveys" asp-action="Index">Anketler</a>
                    <a asp-area="Doctor" asp-controller="Patients" asp-action="Create">Hasta Kaydı</a>
                    <a asp-area="Doctor" asp-controller="PatientVisits" asp-action="Index">Hasta Ziyaretleri</a>
                    <a asp-area="Doctor" asp-controller="Tokens" asp-action="Index">Linkler</a>
                    <a asp-area="Doctor" asp-controller="Results" asp-action="Index">Sonuçlar</a>
                }
                else
                {
                    <a class="@(isAdminArea ? "is-active" : null)" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Özet</a>
                    <a asp-area="Admin" asp-controller="Surveys" asp-action="Index">Anketler</a>
                    <a asp-area="Admin" asp-controller="Questions" asp-action="Index">Sorular</a>
                    <a asp-area="Admin" asp-controller="Tokens" asp-action="Index">Linkler</a>
                    <a asp-area="Admin" asp-controller="PatientVisits" asp-action="Index">Hasta Ziyaretleri</a>
                    <a asp-area="Admin" asp-controller="Results" asp-action="Index">Sonuçlar</a>
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index">Kullanıcılar</a>
                    <a asp-area="Admin" asp-controller="SystemHistory" asp-action="Index">Sistem Geçmişi</a>
                }
            </div>
        }
    </header>

    <div class="page-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <span>&copy; 2026 Hasta Memnuniyet Anketi Sistemi</span>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
