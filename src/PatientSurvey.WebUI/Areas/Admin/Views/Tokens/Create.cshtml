@using PatientSurvey.Application.DTOs.PatientVisit
@using PatientSurvey.Domain.Enums
@model CreateTokenViewModel

@{
    ViewData["Title"] = "Yeni Anket Linki";
}

<section class="admin-page">
    @if (Model.CreatedInvitation is not null)
    {
        var createdUrl = $"{Model.SurveyUrlPrefix}{Model.CreatedInvitation.Token}";
        <div class="success-panel">
            <h1>Anket Linki Oluşturuldu</h1>
            <div class="copy-row">
                <input class="copy-input" value="@createdUrl" readonly data-copy-source />
                <button type="button" class="secondary-button" data-copy-button>Linki Kopyala</button>
            </div>
        </div>
    }
    else
    {
        <div class="admin-heading">
            <div>
                <h1>Yeni Anket Linki</h1>
                <p>Var olan bir hasta ziyaretine SMS, e-posta veya sadece link olarak anket daveti bağlayın.</p>
            </div>
            <a class="secondary-button" asp-area="Admin" asp-controller="PatientVisits" asp-action="Create">Yeni Hasta Ziyareti</a>
        </div>

        <form asp-action="Create" method="post" class="admin-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="field-block">
                <label asp-for="PatientVisitId">Hasta ziyareti</label>
                <select asp-for="PatientVisitId">
                    <option value="">Ziyaret seçin</option>
                    @foreach (var visit in Model.PatientVisits)
                    {
                        <option value="@visit.Id">@FormatVisitOption(visit)</option>
                    }
                </select>
                <span asp-validation-for="PatientVisitId" class="field-validation"></span>
            </div>

            <div class="field-block">
                <label asp-for="SurveyId">Anket</label>
                <select asp-for="SurveyId">
                    <option value="">Anket seçin</option>
                    @foreach (var survey in Model.Surveys.Where(survey => survey.IsActive))
                    {
                        <option value="@survey.Id">@survey.Title (@(survey.IsGeneral ? "Genel" : "Hedefli"))</option>
                    }
                </select>
                <span asp-validation-for="SurveyId" class="field-validation"></span>
            </div>

            <div class="field-grid">
                <div class="field-block">
                    <label asp-for="DeliveryMethod">Gönderim yöntemi</label>
                    <select asp-for="DeliveryMethod">
                        <option value="@SurveyDeliveryMethod.LinkOnly">Sadece link</option>
                        <option value="@SurveyDeliveryMethod.Sms">SMS</option>
                        <option value="@SurveyDeliveryMethod.Email">E-posta</option>
                    </select>
                </div>

                <div class="field-block">
                    <label asp-for="ExpiresAtUtc">Son kullanma tarihi</label>
                    <input asp-for="ExpiresAtUtc" type="datetime-local" />
                    <span asp-validation-for="ExpiresAtUtc" class="field-validation"></span>
                </div>
            </div>

            <button type="submit" class="primary-button">Link Oluştur</button>
        </form>
    }
</section>

@functions {
    private static string FormatVisitOption(PatientVisitListItemDto visit)
    {
        var contact = FormatContact(visit);
        var doctor = string.IsNullOrWhiteSpace(visit.DoctorName) ? "Doktor yok" : visit.DoctorName;
        return $"#{visit.Id} - {visit.PatientName} | {visit.DepartmentName} | {doctor} | {contact}";
    }

    private static string FormatContact(PatientVisitListItemDto visit)
    {
        var parts = new[] { visit.PatientPhone, visit.PatientEmail }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .ToArray();

        return parts.Length == 0 ? "İletişim bilgisi yok" : string.Join(" / ", parts);
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
