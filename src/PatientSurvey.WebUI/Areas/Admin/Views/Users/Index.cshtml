@model UserIndexViewModel

@{
    ViewData["Title"] = "Kullanıcılar";
}

<section class="admin-page">
    <div class="admin-heading">
        <h1>Kullanıcı Yönetimi</h1>
        <a class="primary-button" asp-action="Create">Yeni Kullanıcı</a>
    </div>

    @if (Model.Users.Count == 0)
    {
        <p>Henüz kullanıcı yok.</p>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Kullanıcı adı</th>
                    <th>Rol</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Username</td>
                        <td>@user.RoleName</td>
                        <td>@(user.IsActive ? "Aktif" : "Pasif")</td>
                        <td>
                            <form asp-action="Toggle" asp-route-id="@user.Id" method="post" class="inline-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="secondary-button">@(user.IsActive ? "Pasif yap" : "Aktif yap")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
