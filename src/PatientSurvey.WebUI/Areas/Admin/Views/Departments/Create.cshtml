@model CreateDepartmentViewModel

@{
    ViewData["Title"] = "Yeni Bölüm";
}

<section class="admin-page">
    <h1>Yeni Bölüm</h1>

    <form asp-action="Create" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field-block">
            <label asp-for="Name">Bölüm adı</label>
            <input asp-for="Name" />
            <span asp-validation-for="Name" class="field-validation"></span>
        </div>

        <label class="check-row">
            <input asp-for="IsActive" />
            <span>Aktif</span>
        </label>

        <button type="submit" class="primary-button">Kaydet</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
