@using PatientSurvey.Domain.Enums
@model CreatePatientVisitViewModel

@{
    ViewData["Title"] = "Yeni Hasta Ziyareti";
}

<section class="admin-page">
    @if (Model.CreatedInvitation is not null)
    {
        var createdUrl = $"{Model.SurveyUrlPrefix}{Model.CreatedInvitation.Token}";
        <div class="success-panel">
            <h1>Hasta Ziyareti Oluşturuldu</h1>
            <div class="copy-row">
                <input class="copy-input" value="@createdUrl" readonly data-copy-source />
                <button type="button" class="secondary-button" data-copy-button>Linki Kopyala</button>
            </div>
        </div>
    }
    else
    {
        <div class="admin-heading">
            <div>
                <h1>Yeni Hasta Ziyareti</h1>
                <p>Hasta ziyaretini kaydedin ve seçilen anket için davet linki oluşturun.</p>
            </div>
            <a class="secondary-button" asp-area="Admin" asp-controller="PatientVisits" asp-action="Index">Ziyaretlere Dön</a>
        </div>

        <form asp-action="Create" method="post" class="admin-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="field-block">
                <label asp-for="SurveyId">Anket</label>
                <select asp-for="SurveyId">
                    <option value="">Anket seçin</option>
                    @foreach (var survey in Model.Surveys.Where(survey => survey.IsActive))
                    {
                        <option value="@survey.Id">@survey.Title (@(survey.IsGeneral ? "Genel" : "Hedefli"))</option>
                    }
                </select>
                <span asp-validation-for="SurveyId" class="field-validation"></span>
            </div>

            <div class="field-grid">
                <div class="field-block">
                    <label asp-for="PatientFirstName">Hasta adı</label>
                    <input asp-for="PatientFirstName" autocomplete="off" />
                    <span asp-validation-for="PatientFirstName" class="field-validation"></span>
                </div>

                <div class="field-block">
                    <label asp-for="PatientLastName">Hasta soyadı</label>
                    <input asp-for="PatientLastName" autocomplete="off" />
                    <span asp-validation-for="PatientLastName" class="field-validation"></span>
                </div>
            </div>

            <div class="field-grid">
                <div class="field-block">
                    <label asp-for="TcIdentityNumber">T.C. Kimlik Numarası</label>
                    <input asp-for="TcIdentityNumber" inputmode="numeric" autocomplete="off" />
                    <span asp-validation-for="TcIdentityNumber" class="field-validation"></span>
                </div>

                <div class="field-block">
                    <label asp-for="PhoneNumber">Telefon (opsiyonel)</label>
                    <input asp-for="PhoneNumber" />
                    <span asp-validation-for="PhoneNumber" class="field-validation"></span>
                </div>
            </div>

            <div class="field-grid">
                <div class="field-block">
                    <label asp-for="Email">E-posta (opsiyonel)</label>
                    <input asp-for="Email" />
                    <span asp-validation-for="Email" class="field-validation"></span>
                </div>

                <div class="field-block">
                    <label asp-for="ExpiresAtUtc">Son kullanma tarihi</label>
                    <input asp-for="ExpiresAtUtc" type="datetime-local" />
                    <span asp-validation-for="ExpiresAtUtc" class="field-validation"></span>
                </div>
            </div>

            <div class="field-block">
                <label asp-for="DeliveryMethod">Gönderim yöntemi</label>
                <select asp-for="DeliveryMethod">
                    <option value="@SurveyDeliveryMethod.LinkOnly">Sadece link</option>
                    <option value="@SurveyDeliveryMethod.Sms">SMS</option>
                    <option value="@SurveyDeliveryMethod.Email">E-posta</option>
                </select>
            </div>

            <button type="submit" class="primary-button">Hasta Ziyareti Oluştur</button>
        </form>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
