@model QuestionIndexViewModel

@{
    ViewData["Title"] = "Sorular";
}

<section class="admin-page">
    <div class="admin-heading">
        <h1>Soru Yönetimi</h1>
        <a class="primary-button" asp-action="Create">Yeni Soru</a>
    </div>

    <form method="get" class="filter-bar">
        <div class="field-block">
            <label for="surveyId">Anket</label>
            <select id="surveyId" name="surveyId">
                <option value="">Tüm anketler</option>
                @foreach (var survey in Model.Surveys)
                {
                    <option value="@survey.Id" selected="@(Model.SurveyId == survey.Id)">@survey.Title</option>
                }
            </select>
        </div>
        <div class="field-block">
            <label for="type">Tip</label>
            <select id="type" name="type">
                <option value="">Tüm tipler</option>
                @foreach (var type in Enum.GetValues<QuestionType>())
                {
                    <option value="@type" selected="@(Model.Type == type)">@type</option>
                }
            </select>
        </div>
        <div class="field-block">
            <label for="status">Durum</label>
            <select id="status" name="status">
                <option value="">Tüm durumlar</option>
                <option value="active" selected="@(Model.Status == "active")">Aktif</option>
                <option value="passive" selected="@(Model.Status == "passive")">Pasif</option>
            </select>
        </div>
        <div class="field-block filter-search">
            <label for="search">Arama</label>
            <input id="search" name="search" value="@Model.Search" placeholder="Soru veya anket adı" />
        </div>
        <div class="filter-actions">
            <button type="submit" class="primary-button">Filtrele</button>
            <a class="secondary-button" asp-action="Index">Temizle</a>
        </div>
    </form>

    <p class="filter-summary">@Model.Questions.Count / @Model.TotalCount soru gösteriliyor.</p>

    @if (Model.Questions.Count == 0)
    {
        <p>Filtreye uygun soru bulunamadı.</p>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Anket</th>
                    <th>Sıra</th>
                    <th>Soru</th>
                    <th>Tip</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var question in Model.Questions)
                {
                    <tr>
                        <td>@question.SurveyTitle</td>
                        <td>@question.DisplayOrder</td>
                        <td>@question.Text</td>
                        <td>@question.Type</td>
                        <td>@(question.IsActive ? "Aktif" : "Pasif")</td>
                        <td>
                            <form asp-action="Toggle" asp-route-id="@question.Id" method="post" class="inline-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="secondary-button">@(question.IsActive ? "Pasif yap" : "Aktif yap")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
