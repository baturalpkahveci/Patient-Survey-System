@model DashboardViewModel

@{
    ViewData["Title"] = "Manager Paneli";
}

<section class="admin-page">
    <div class="admin-heading">
        <div>
            <span class="eyebrow">Operasyon ozeti</span>
            <h1>Manager Paneli</h1>
            <p>Anket linklerini üret, gelen sonuclari takip et ve raporları incele.</p>
        </div>
        <a class="primary-button" asp-area="Manager" asp-controller="Tokens" asp-action="Create">Yeni Link</a>
    </div>

    <div class="stat-grid">
        <div class="stat-tile"><span>Anket</span><strong>@Model.Overview.SurveyCount</strong></div>
        <div class="stat-tile"><span>Aktif Anket</span><strong>@Model.Overview.ActiveSurveyCount</strong></div>
        <div class="stat-tile"><span>Soru</span><strong>@Model.Overview.QuestionCount</strong></div>
        <div class="stat-tile"><span>Cevap</span><strong>@Model.Overview.ResponseCount</strong></div>
        <div class="stat-tile"><span>Link</span><strong>@Model.Overview.TokenCount</strong></div>
        <div class="stat-tile"><span>Kullanılmamış Link</span><strong>@Model.Overview.UnusedTokenCount</strong></div>
    </div>

    <div class="admin-grid">
        <a asp-area="Manager" asp-controller="Tokens" asp-action="Index"><strong>Anket Linkleri</strong><span>Hazır ve kullanılmış bağlantılar</span></a>
        <a asp-area="Manager" asp-controller="Results" asp-action="Index"><strong>Sonuçlar</strong><span>Gönderilen anket yanıtları</span></a>
        <a asp-area="Manager" asp-controller="Reports" asp-action="Index"><strong>Raporlar</strong><span>Ortalama puan ve bölüm kirilimlari</span></a>
    </div>
</section>
