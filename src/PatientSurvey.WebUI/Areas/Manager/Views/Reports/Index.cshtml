@model ReportIndexViewModel

@{
    ViewData["Title"] = "Raporlar";
}

<section class="admin-page">
    <div class="admin-heading">
        <h1>Raporlar</h1>
    </div>

    <form method="get" class="filter-bar">
        <div class="field-block filter-search">
            <label for="search">Anket</label>
            <input id="search" name="search" value="@Model.Search" placeholder="Anket adı ara" />
        </div>
        <div class="field-block">
            <label for="status">Durum</label>
            <select id="status" name="status">
                <option value="">Tüm durumlar</option>
                <option value="active" selected="@(Model.Status == "active")">Aktif</option>
                <option value="passive" selected="@(Model.Status == "passive")">Pasif</option>
            </select>
        </div>
        <div class="field-block">
            <label for="minResponses">Min. Cevap</label>
            <input id="minResponses" name="minResponses" type="number" min="0" step="1" value="@Model.MinResponses" />
        </div>
        <div class="filter-actions">
            <button type="submit" class="primary-button">Filtrele</button>
            <a class="secondary-button" asp-action="Index">Temizle</a>
        </div>
    </form>

    <p class="filter-summary">@Model.Reports.Count / @Model.TotalCount rapor gösteriliyor.</p>

    @if (Model.Reports.Count == 0)
    {
        <p>Filtreye uygun rapor bulunamadı.</p>
    }
    else
    {
        <div class="report-list">
            @foreach (var report in Model.Reports)
            {
                <article class="report-panel">
                    <div class="admin-heading">
                        <h2>@report.SurveyTitle</h2>
                        <span class="status-pill">@(report.IsActive ? "Aktif" : "Pasif")</span>
                    </div>
                    <div class="detail-grid">
                        <div><span>Soru</span><strong>@report.QuestionCount</strong></div>
                        <div><span>Link</span><strong>@report.TokenCount</strong></div>
                        <div><span>Cevap</span><strong>@report.ResponseCount</strong></div>
                        <div><span>Puan Ortalaması</span><strong>@(report.AverageScore?.ToString("0.00") ?? "-")</strong></div>
                    </div>

                    @if (report.Departments.Count > 0)
                    {
                        <table class="admin-table compact-table">
                            <thead>
                                <tr>
                                    <th>Bölüm</th>
                                    <th>Cevap</th>
                                    <th>Puan Ortalaması</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var department in report.Departments)
                                {
                                    <tr>
                                        <td>@department.DepartmentName</td>
                                        <td>@department.ResponseCount</td>
                                        <td>@(department.AverageScore?.ToString("0.00") ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </article>
            }
        </div>
    }
</section>
