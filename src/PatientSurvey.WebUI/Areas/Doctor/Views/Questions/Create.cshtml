@model CreateQuestionViewModel

@{
    ViewData["Title"] = "Yeni Soru";
}

<section class="admin-page">
    <div class="admin-heading">
        <div>
            <h1>Yeni Soru</h1>
            <p>Doktor panelinde yalnızca kendi bölümünüz için oluşturduğunuz anketlere soru ekleyebilirsiniz.</p>
        </div>
        <a class="secondary-button" asp-area="Doctor" asp-controller="Surveys" asp-action="Index">Anketlere Dön</a>
    </div>

    <form asp-action="Create" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field-block">
            <label asp-for="SurveyId">Anket</label>
            <select asp-for="SurveyId">
                <option value="">Anket seçin</option>
                @foreach (var survey in Model.Surveys)
                {
                    <option value="@survey.Id">@survey.Title</option>
                }
            </select>
            <span asp-validation-for="SurveyId" class="field-validation"></span>
        </div>

        <div class="field-block">
            <label asp-for="Text">Soru metni</label>
            <textarea asp-for="Text" rows="3"></textarea>
            <span asp-validation-for="Text" class="field-validation"></span>
        </div>

        <div class="field-block">
            <label asp-for="Type">Soru tipi</label>
            <select asp-for="Type" asp-items="Html.GetEnumSelectList<QuestionType>()"></select>
            <span asp-validation-for="Type" class="field-validation"></span>
        </div>

        <div class="field-block">
            <label asp-for="DisplayOrder">Sıra</label>
            <input asp-for="DisplayOrder" type="number" min="1" max="1000" />
            <span asp-validation-for="DisplayOrder" class="field-validation"></span>
        </div>

        <label class="check-row">
            <input asp-for="IsRequired" />
            <span>Zorunlu</span>
        </label>

        <label class="check-row">
            <input asp-for="IsActive" />
            <span>Aktif</span>
        </label>

        <div class="filter-actions">
            <button type="submit" class="primary-button">Soruyu Kaydet</button>
            <a class="secondary-button" asp-area="Doctor" asp-controller="Patients" asp-action="Create" asp-route-surveyId="@Model.SurveyId">Hasta Kaydına Geç</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
