@model DoctorTokenIndexViewModel

@{
    ViewData["Title"] = "Linkler";
}

<section class="admin-page">
    <div class="admin-heading">
        <div>
            <h1>Linkler</h1>
            <p>Hastalara gönderdiğiniz anket linklerini buradan tekrar kopyalayabilirsiniz.</p>
        </div>
        <a class="primary-button" asp-area="Doctor" asp-controller="Patients" asp-action="Create">Hasta Kaydı</a>
    </div>

    <form method="get" class="filter-bar">
        <div class="field-block filter-search">
            <label for="search">Arama</label>
            <input id="search" name="search" value="@Model.Search" placeholder="Anket veya link" />
        </div>
        <div class="field-block">
            <label for="surveyId">Anket</label>
            <select id="surveyId" name="surveyId">
                <option value="">Tüm anketler</option>
                @foreach (var survey in Model.SurveyOptions)
                {
                    <option value="@survey.Value" selected="@(Model.SurveyId?.ToString() == survey.Value)">@survey.Text</option>
                }
            </select>
        </div>
        <div class="field-block">
            <label for="deliveryStatus">Gönderim</label>
            <select id="deliveryStatus" name="deliveryStatus">
                <option value="">Tümü</option>
                @foreach (var delivery in Model.DeliveryOptions)
                {
                    <option value="@delivery.Value" selected="@(Model.DeliveryStatus == delivery.Value)">@delivery.Text</option>
                }
            </select>
        </div>
        <div class="filter-actions">
            <button type="submit" class="primary-button">Filtrele</button>
            <a class="secondary-button" asp-action="Index">Temizle</a>
            <span class="filter-summary">@Model.Tokens.Count / @Model.TotalCount link</span>
        </div>
    </form>

    @if (Model.Tokens.Count == 0)
    {
        <p>Filtreye uygun link yok.</p>
    }
    else
    {
        <table class="admin-table token-table">
            <thead>
                <tr>
                    <th>Anket</th>
                    <th>Link</th>
                    <th>Gönderim</th>
                    <th>Tarihler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var token in Model.Tokens)
                {
                    var url = $"{Model.SurveyUrlPrefix}{token.Token}";
                    <tr>
                        <td>
                            <strong>@token.SurveyTitle</strong>
                            @if (token.InvitationId.HasValue)
                            {
                                <span class="table-note">Davet #@token.InvitationId</span>
                            }
                        </td>
                        <td>
                            <div class="inline-copy">
                                <input class="copy-input inline-copy-input" value="@url" readonly data-copy-source="@token.Id" />
                                <button type="button" class="icon-button" data-copy-button data-copy-target="@token.Id" aria-label="Linki kopyala" title="Linki kopyala">
                                    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
                                        <path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07l-1.62 1.62" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 1 0 7.07 7.07l1.62-1.62" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </button>
                            </div>
                        </td>
                        <td>@FormatDeliveryStatus(token.DeliveryStatus)</td>
                        <td>
                            <strong>@token.CreatedAtUtc.ToLocalTime().ToString("g")</strong>
                            <span class="table-note">Son: @(token.ExpiresAtUtc?.ToLocalTime().ToString("g") ?? "-")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@functions {
    private static string FormatDeliveryStatus(string value)
    {
        return value switch
        {
            "LinkCreated" => "Link oluşturuldu",
            "Sent" => "Gönderildi",
            "Failed" => "Başarısız",
            "NotConfigured" => "Yapılandırılmadı",
            "Legacy" => "Eski link",
            _ => value
        };
    }
}
